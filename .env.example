# Copie para .env.local e preencha com as credenciais do seu projeto Supabase.
# Nunca commite .env.local (ver .gitignore).

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon) do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service-role do Supabase — apenas server-side, nunca no cliente.
# Só para rotinas admin explicitamente auditadas (ver .cadence/policies/data-handling.md).
SUPABASE_SERVICE_ROLE_KEY=

# String de conexão Postgres (Drizzle)
DATABASE_URL=
