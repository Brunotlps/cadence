# Copie para .env.local e preencha com as credenciais do seu projeto Supabase.
# Nunca commite .env.local (ver .gitignore).

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon) do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service-role do Supabase — apenas server-side, nunca no cliente.
# Só para rotinas admin explicitamente auditadas (ver .cadence/policies/data-handling.md).
SUPABASE_SERVICE_ROLE_KEY=

# Origem confiável da aplicação (ex: https://cadence-red-rho.vercel.app), usada
# para montar links de confirmação/recuperação enviados por e-mail. Obrigatória
# em produção — sem ela, as Server Actions de auth cairiam pro header Host da
# requisição, que é forjável (host header injection). Deixe vazio em dev/test:
# nesse caso o fallback usa o Host da própria requisição local.
APP_URL=

# String de conexão Postgres usada em runtime pela aplicação (pooler, transaction mode).
DATABASE_URL=

# String de conexão direta (ou pooler em modo session), usada só por drizzle-kit
# generate/migrate. DDL não é confiável sobre o pooler em transaction mode.
# Nota: a "Direct connection" real do Supabase (db.<ref>.supabase.co) é
# IPv6-only. Em ambiente sem saída IPv6, use a "Session pooler" do Dashboard
# (porta 5432, host aws-0-<region>.pooler.supabase.com) — IPv4-compatível e
# também suporta DDL.
DIRECT_URL=
